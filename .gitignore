# Dependencies
node_modules/

# Secret calendar feed URLs — these are credential-equivalent.
# Anyone holding one of these URLs can read that calendar indefinitely.
calendars.local.json

# Gmail OAuth client credentials and the stored refresh token.
gmail.local.json

# Personal calendar exports
*.ical.zip
*.ics
# ...except the parser's test fixtures, which hold only made-up events.
# scripts/check.js allows the same folder, and fails if a file there has a
# real UID or email address.
!test/fixtures/*.ics

# Build output
dist/
out/

# Logs
*.log
npm-debug.log*
